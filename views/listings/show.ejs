<% layout("/layouts/boilerplate")%>
<body>
<div class="card mx-auto" style="width: 100%; max-width: 40rem;">
  <h3>Listing Details : </h3>
  <img src="<%=listing.image%>"" class="card-img-top" alt="not found" style="height: 400px; object-fit: cover;">
  <div class="card-body">
    <h5 class="card-title"><b><%= listing.title %></b></h5>
    <p class="card-text"><%= listing.description %></p>

  <ul class="list-group list-group-flush">
    <li class="list-group-item">&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
    <li class="list-group-item"><%= listing.location %></li>
    <li class="list-group-item"><%= listing.country %></li>
  </ul>
  <div class="card-body">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
    <br><br>
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark">Delete</button>
    </form>
  </div>
</div>
</body>